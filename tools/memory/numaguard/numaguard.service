[Unit]
Description=NUMA node thrashing guard
After=local-fs.target

[Service]
# Rules: /etc/numaguard/rules.d/*.rules. Reload after editing them.
ExecStart=/usr/local/sbin/numaguard
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
RuntimeDirectory=numaguard
RuntimeDirectoryPreserve=yes
Nice=-10
OOMScoreAdjust=-1000
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
